# ============================================================================
# ResolveGrid — Production Environment Configuration (aetherhost.com.ng)
# ============================================================================

# 1. Official NIPOST National Digital Alphanumeric Postcode API (NDAPS)
# Register at https://dashboard.postcode.gov.ng/register
# Test keys start with nipost_test_... (free/unmetered sandbox)
# Live keys start with nipost_live_... (production after KYB)
NIPOST_BASE_URL=https://api.postcode.gov.ng
NIPOST_API_KEY=nipost_test_replace_with_your_dashboard_key
NIPOST_DEFAULT_LOOKUP_LEVEL=3

# 2. Multi-Provider LLM Configuration (FastAPI NIPOST Tool-Calling Agent)
# Set one or more keys below; the agent automatically chains/falls back across active keys
LLM_PRIMARY_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# 3. Core Backend Infrastructure (Node.js Gateway + MySQL 8.0 + Redis 7)
PORT=4000
NODE_ENV=development
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=resolvegrid
MYSQL_PASSWORD=resolvegrid_secret_2026
MYSQL_DATABASE=resolvegrid
REDIS_URL=redis://127.0.0.1:6379

# 4. Internal Service Routing & Security
ML_ENGINE_URL=http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ML_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:4000
KYC_SIGNING_SECRET=aetherhost_resolvegrid_kyc_hmac_secret_2026_prod
# Used only by an administrator to provision field accounts; never expose it in a client app.
FIELD_ADMIN_KEY=
# Random server secret used to sign short-lived field-agent sessions; never expose it in a client app.
FIELD_SESSION_SECRET=

# 5. Live External Telemetry Feeds (Zero-Mock Physical World APIs)
# Open-Meteo (Live Weather — Free, no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# OSRM Real Road Network Routing (Free public OSRM server or self-hosted)
OSRM_BASE_URL=https://router.project-osrm.org
# OpenSky Network Live Transponder Feed (Nigeria / West Africa Bounding Box)
OPENSKY_BASE_URL=https://opensky-network.org/api/states/all
ENABLE_LIVE_TELEMETRY_WORKER=true
TELEMETRY_POLL_INTERVAL_MS=15000
